{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "SYNJ",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#literals"
		},
		{
			"include": "#punctuation"
		}
	],
	"repository": {
		"comments": {
			"patterns": [{
				"name": "comment.line.double-slash.synj",
				"match": "//.*"
			}]
		},
		"keywords": {
			"patterns": [
				{
				"name": "variable.language.synj",
				"match": "\\b(model_name|algorithm|csv_path|train_test_split|target|features|classes|epochs|learning_rate|batch_size|early_stop|output_path)\\b(?=\\s*=)"
				},
				{
					"name": "support.constant.synj",
					"match": "\\b(LinearRegression|LogisticRegression)\\b"
				}
			]
		},
		"literals": {
			"patterns": [
				{
					"name": "constant.numeric.synj",
					"match": "\\b-?[0-9]+(\\.[0-9]+)?\\b"
				},
				{
					"name": "constant.language.null.synj",
					"match": "\\bNULL\\b"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.synj",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.synj",
					"match": "\\\\."
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "keyword.operator.assignment.synj",
					"match": "-"
				},
				{
					"name": "punctuation.terminator.statement.synj",
					"match": ";"
				},
				{
					"name": "punctuation.separator.synj",
					"match": ",|:"
				},
				{
					"name": "punctuation.definition.array.begin.synj",
					"match": "\\["
				},
				{
					"name": "punctuation.definition.array.end.synj",
					"match": "\\]"
				},
				{
					"name": "punctuation.definition.object.begin.synj",
					"match": "\\{"
				},
				{
					"name": "punctuation.definition.object.end.synj",
					"match": "\\}"
				}
			]
		}
	},
	"scopeName": "source.synj"
}